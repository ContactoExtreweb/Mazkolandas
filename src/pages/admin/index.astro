---
import Admin from '../../layouts/Admin.astro'
---

<Admin title="Entradas">
  <div class="cabeza">
    <h1>Cuaderno de campo</h1>
    <a class="boton" href="/admin/entrada/">Nueva entrada</a>
  </div>

  <p class="aviso aviso--error" id="error" hidden></p>
  <p class="ayuda" id="cargando">Cargando entradas…</p>
  <ol class="lista" id="lista"></ol>
  <p class="vacio" id="vacio" hidden>Todavía no hay entradas. Escribe la primera: con una foto y unas líneas basta.</p>

  <details class="consejos">
    <summary>Cómo escribir para salir en Google</summary>
    <ul>
      <li>Pon en el título lo que la gente buscaría y el lugar: <em>«Así fue la vendimia 2026 en Cirauqui»</em> mejor que <em>«¡Por fin!»</em>.</li>
      <li>Nombra Navarra, Cirauqui, Tierra Estella o el Camino de Santiago cuando venga a cuento, con naturalidad.</li>
      <li>El resumen es lo que sale en Google: una o dos frases que cuenten de qué va la entrada.</li>
      <li>Usa subtítulos (<code>## </code>) para separar partes. Google los lee.</li>
      <li>Cada foto con su pie: qué se ve, dónde y cuándo.</li>
      <li>Mejor dos entradas al mes que diez un mes y luego nada.</li>
      <li>Ideas: la poda, el envero, la vendimia, qué uvas se cultivan en Navarra, cómo es Cirauqui, del racimo a la botella, los eventos a los que vais (como Los Vinos de Iruña).</li>
    </ul>
  </details>

  <style>
    .cabeza {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .lista {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--tinta);
    }
    .lista :global(li) {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.4rem 1rem;
      align-items: center;
      padding: 1rem 0;
      border-bottom: 1px solid var(--filete);
    }
    .lista :global(.titulo) {
      font-family: var(--texto);
      font-weight: 700;
      font-size: 1.1rem;
      line-height: 1.3;
    }
    .lista :global(.meta) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      color: var(--tinta-2);
      grid-column: 1;
    }
    .lista :global(.estado) {
      color: var(--mosto);
      font-weight: 700;
    }
    .lista :global(.estado.borrador) {
      color: var(--tinta-2);
    }
    .lista :global(.acciones) {
      grid-column: 2;
      grid-row: 1 / span 2;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: flex-end;
    }
    .lista :global(.acciones a) {
      text-decoration: none;
    }
    @media (max-width: 600px) {
      .lista :global(li) {
        grid-template-columns: 1fr;
      }
      .lista :global(.acciones) {
        grid-column: 1;
        grid-row: auto;
        justify-content: flex-start;
      }
    }
    .vacio {
      font-family: var(--texto);
      padding: 2rem 0;
      border-bottom: 1px solid var(--tinta);
    }
    .consejos {
      margin-top: 3rem;
      border: 1px solid var(--tinta);
      padding: 1rem 1.25rem;
      background: #fff;
    }
    .consejos summary {
      font-family: var(--texto);
      font-weight: 700;
      cursor: pointer;
    }
    .consejos ul {
      margin: 1rem 0 0;
      padding-left: 1.2rem;
    }
    .consejos li {
      margin-bottom: 0.5rem;
    }
  </style>

  <script>
    import { supabase } from '../../lib/supabaseBrowser.js'
    import { refrescarWeb } from '../../lib/refrescarWeb.js'
    import { numero, fecha } from '../../lib/texto.js'
    import { rutaEnBucket as rutaFoto } from '../../lib/imagen.js'

    const lista = document.getElementById('lista')!
    const error = document.getElementById('error')!
    const mostrarError = (m: string) => {
      error.textContent = m
      error.hidden = false
    }
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&${{ '&': 'amp', '<': 'lt', '>': 'gt', '"': 'quot' }[c]};`)


    async function cargar() {
      if (!supabase) return
      const { data, error: fallo } = await supabase
        .from('posts')
        .select('id, numero, slug, titulo, titulo_eu, fecha, publicado, fotos')
        .order('fecha', { ascending: false })
        .order('numero', { ascending: false })
      document.getElementById('cargando')!.hidden = true
      if (fallo) return mostrarError('No se pudieron cargar las entradas: ' + fallo.message)
      document.getElementById('vacio')!.hidden = data.length > 0

      lista.innerHTML = data
        .map(
          (p) => `<li data-id="${p.id}">
            <span class="titulo">${esc(p.titulo)}</span>
            <span class="meta nota">
              <span>Nº ${numero(p.numero)}</span><span>${fecha(p.fecha)}</span>
              <span class="estado ${p.publicado ? '' : 'borrador'}">${p.publicado ? 'Publicada' : 'Borrador'}</span>
              <span>${p.titulo_eu ? 'ES + EU' : 'Solo ES'}</span>
            </span>
            <span class="acciones">
              <a class="boton-texto" href="/admin/entrada/?id=${p.id}">Editar</a>
              ${p.publicado ? `<a class="boton-texto" href="/cuaderno/${p.slug}" target="_blank" rel="noopener">Ver</a>` : ''}
              <button type="button" class="boton-texto boton-texto--peligro" data-borrar>Borrar</button>
            </span>
          </li>`,
        )
        .join('')

      lista.querySelectorAll<HTMLButtonElement>('[data-borrar]').forEach((b) => {
        b.onclick = async () => {
          const li = b.closest('li')!
          const p = data.find((x) => x.id === li.dataset.id)!
          if (!confirm(`¿Borrar «${p.titulo}»? No se puede deshacer.`)) return
          b.disabled = true
          // .select() para saber si de verdad se borró: si RLS lo bloquea,
          // Supabase no da error, borra 0 filas (lección de Guadicar).
          const { data: borrado, error: fallo } = await supabase!.from('posts').delete().eq('id', p.id).select('id')
          if (fallo || !borrado?.length) {
            b.disabled = false
            return mostrarError('No se borró la entrada. ' + (fallo?.message ?? 'Tu usuario no tiene permiso (tabla admins).'))
          }
          // Primero se borra la entrada y después sus fotos, nunca al revés
          const rutas = (p.fotos ?? []).map((f: any) => rutaFoto(f.url)).filter(Boolean)
          if (rutas.length) await supabase!.storage.from('cuaderno').remove(rutas)
          li.remove()
          refrescarWeb()
        }
      })
    }
    cargar()
  </script>
</Admin>
