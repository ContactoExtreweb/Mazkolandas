---
import Cuaderno from '../../components/Cuaderno.astro'
import { getPosts } from '../../lib/posts.js'
import { cachearEnCDN } from '../../lib/cache.js'

export const prerender = false

const posts = await getPosts('es')
cachearEnCDN(Astro.response.headers)
---

<Cuaderno lang="es" posts={posts} />
